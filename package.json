{
    "name": "api-client",
    "version": "0.1.0",
    "description": "Modern API Client - Postman Clone",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist",
        "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:build": "npm run build && electron-builder"
    },
    "dependencies": {
        "axios": "^1.6.5",
        "dexie": "^4.3.0",
        "dexie-react-hooks": "^4.2.0",
        "framer-motion": "^12.34.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "zustand": "^4.5.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.17",
        "concurrently": "^8.2.2",
        "electron": "^28.1.3",
        "electron-builder": "^24.9.1",
        "gh-pages": "^6.3.0",
        "postcss": "^8.4.33",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "vite": "^5.0.11",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.apiclient.app",
        "productName": "API Client",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*"
        ],
        "win": {
            "target": [
                "nsis"
            ]
        }
    }
}
