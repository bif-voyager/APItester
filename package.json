{
    "name": "api-client",
    "version": "0.1.0",
    "description": "Modern API Client - Postman Clone",
    "main": "dist-electron/main.js",
    "author": {
        "name": "Simon",
        "email": "simon@example.com"
    },
    "scripts": {
        "dev": "vite --port 5173 --strictPort",
        "test": "npm run test:frontend && npm run test:backend",
        "test:frontend": "vitest run",
        "test:frontend:watch": "vitest",
        "test:backend": "go -C backend test ./...",
        "prebuild": "npm test",
        "build": "tsc && vite build",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist",
        "electron:dev": "cross-env ELECTRON=1 vite --port 5173 --strictPort",
        "preelectron:build": "npm test",
        "electron:build": "cross-env ELECTRON=1 tsc && cross-env ELECTRON=1 vite build && electron-builder"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.95.3",
        "@types/uuid": "^10.0.0",
        "axios": "^1.6.5",
        "dexie": "^4.3.0",
        "dexie-react-hooks": "^4.2.0",
        "framer-motion": "^12.34.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "uuid": "^13.0.0",
        "zustand": "^4.5.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.17",
        "concurrently": "^8.2.2",
        "cross-env": "^10.1.0",
        "electron": "^25.9.8",
        "electron-builder": "^24.9.1",
        "gh-pages": "^6.3.0",
        "postcss": "^8.4.33",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "vite": "^5.0.11",
        "vite-plugin-electron": "^0.29.0",
        "vitest": "^1.6.1",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.apiclient.app",
        "productName": "API Client",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                "nsis"
            ],
            "sign": null,
            "verifyUpdateCodeSignature": false
        },
        "asar": false
    }
}
